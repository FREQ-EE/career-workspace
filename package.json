{
  "name": "career-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "test": "node --experimental-transform-types --test tests/*.test.ts tests/*.test.mjs",
    "package": "node scripts/package.mjs",
    "build:sites": "vite build",
    "dev:sites": "vite --host 127.0.0.1",
    "prebuild": "node scripts/compile-schemas.mjs",
    "prebuild:sites": "node scripts/compile-schemas.mjs",
    "pretypecheck": "node scripts/compile-schemas.mjs",
    "prevalidate": "node scripts/compile-schemas.mjs",
    "test:runtime": "node scripts/smoke.mjs",
    "audit": "node scripts/audit.mjs",
    "assemble:local": "node scripts/assemble-local.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "fflate": "0.8.2",
    "pdf-lib": "1.17.1",
    "@pdf-lib/fontkit": "1.1.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@tailwindcss/postcss": "4.2.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "@cloudflare/vite-plugin": "1.37.1",
    "wrangler": "4.92.0",
    "react-server-dom-webpack": "19.2.6",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26"
  }
}
