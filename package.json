{
  "name": "career-workspace",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/run-local.mjs --dev",
    "build": "next build",
    "start": "node scripts/run-local.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "package": "node scripts/package.mjs",
    "build:sites": "node scripts/build-sites.mjs",
    "dev:sites": "vite --host 127.0.0.1",
    "prebuild": "node scripts/compile-schemas.mjs && node scripts/clean-standalone.mjs",
    "prebuild:sites": "node scripts/compile-schemas.mjs",
    "pretypecheck": "node scripts/compile-schemas.mjs",
    "prevalidate": "node scripts/compile-schemas.mjs",
    "test:runtime": "node scripts/smoke.mjs",
    "audit": "node scripts/audit.mjs",
    "desktop": "electron .",
    "postbuild": "node scripts/prepare-desktop.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "test:ui": "playwright test",
    "check:release": "npm run typecheck && npm run validate && npm test && npm run audit && npm run build && npm run test:runtime && npm run build:sites && npm run package"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "fflate": "0.8.2",
    "jose": "^6.2.14",
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^5.7.284",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.312",
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "description": "A private, local career workspace with provider-independent AI connections.",
  "main": "desktop/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/FREQ-EE/career-workspace.git"
  }
}
